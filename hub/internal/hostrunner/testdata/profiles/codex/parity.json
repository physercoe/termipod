{
  "family": "codex",
  "corpus": "corpus.jsonl",
  "profile": {
    "description": "codex app-server (JSON-RPC 2.0 notifications, line-delimited)\n→ typed agent_events. ADR-012 is the authoritative design;\nprotocol reference at developers.openai.com/codex/app-server.\n\nDispatch is on `method`. Nested matchers like\n`params.item.type` walk dotted paths. Most-specific match\nwins (largest match-keyset; declaration order on ties).\nUnmatched frames fall through to ApplyProfile's\nkind=raw fallback so new methods stay forward-compatible.\n\nItem-shaped notifications (`item/started`, `item/completed`)\ndispatch on `params.item.type` to map onto our existing\ntext/tool_call/tool_result vocabulary so the mobile renderer\nworks with no per-engine branches. Streaming deltas do not\ntraverse this profile at all — AppServerDriver buffers them\nper item and throttle-flushes: item/agentMessage/delta as\npartial `text`, item/commandExecution/outputDelta as\n`tool_call_update` (vision-parity E3). The rules below stay\nthe completion-shaped half, so a transcript replay reads the\nsame as claude-code's whether or not the partials survive.\n",
    "profile_version": 1,
    "rules": [
      {
        "match": {
          "method": "thread/started"
        },
        "emit": {
          "kind": "session.init",
          "producer": "agent",
          "payload": {
            "created_at": "$.params.thread.createdAt",
            "ephemeral": "$.params.thread.ephemeral",
            "model": "$.params.thread.model || $.params.thread.modelProvider",
            "preview": "$.params.thread.preview",
            "session_id": "$.params.thread.id"
          }
        }
      },
      {
        "match": {
          "method": "thread/status/changed"
        },
        "emit": {
          "kind": "system",
          "producer": "agent",
          "payload_expr": "$.params"
        }
      },
      {
        "match": {
          "method": "turn/started"
        },
        "emit": {
          "kind": "system",
          "producer": "agent",
          "payload": {
            "kind": "\"turn_started\"",
            "turn_id": "$.params.turn.id"
          }
        }
      },
      {
        "match": {
          "method": "turn/completed"
        },
        "emit": {
          "kind": "turn.result",
          "producer": "agent",
          "payload": {
            "duration_ms": "$.params.turn.durationMs",
            "status": "$.params.turn.status",
            "terminal_reason": "$.params.turn.error.message",
            "turn_id": "$.params.turn.id"
          }
        }
      },
      {
        "match": {
          "method": "turn/diff/updated"
        },
        "emit": {
          "kind": "system",
          "producer": "agent",
          "payload_expr": "$.params"
        }
      },
      {
        "match": {
          "method": "turn/plan/updated"
        },
        "emit": {
          "kind": "plan",
          "producer": "agent",
          "payload": {
            "explanation": "$.params.explanation",
            "turn_id": "$.params.turnId"
          },
          "payload_lists": {
            "entries": {
              "source": "$.params.plan",
              "fields": {
                "content": "$.step",
                "status": "$.status"
              }
            }
          }
        }
      },
      {
        "match": {
          "method": "item/started",
          "params.item.type": "agentMessage"
        },
        "emit": {
          "kind": "system",
          "producer": "agent",
          "payload": {
            "item_id": "$.params.item.id",
            "kind": "\"agent_message_started\""
          }
        }
      },
      {
        "match": {
          "method": "item/started",
          "params.item.type": "commandExecution"
        },
        "emit": {
          "kind": "tool_call",
          "producer": "agent",
          "payload": {
            "id": "$.params.item.id",
            "input": "$.params.item",
            "name": "\"commandExecution\""
          }
        }
      },
      {
        "match": {
          "method": "item/started",
          "params.item.type": "fileChange"
        },
        "emit": {
          "kind": "tool_call",
          "producer": "agent",
          "payload": {
            "id": "$.params.item.id",
            "input": "$.params.item",
            "name": "\"fileChange\""
          }
        }
      },
      {
        "match": {
          "method": "item/started",
          "params.item.type": "mcpToolCall"
        },
        "emit": {
          "kind": "tool_call",
          "producer": "agent",
          "payload": {
            "id": "$.params.item.id",
            "input": "$.params.item.arguments",
            "name": "$.params.item.tool",
            "server": "$.params.item.server"
          }
        }
      },
      {
        "match": {
          "method": "item/started",
          "params.item.type": "webSearch"
        },
        "emit": {
          "kind": "tool_call",
          "producer": "agent",
          "payload": {
            "id": "$.params.item.id",
            "input": "$.params.item",
            "name": "\"webSearch\""
          }
        }
      },
      {
        "match": {
          "method": "item/completed",
          "params.item.type": "agentMessage"
        },
        "emit": {
          "kind": "text",
          "producer": "agent",
          "payload": {
            "message_id": "$.params.item.id",
            "phase": "$.params.item.phase",
            "text": "$.params.item.text"
          }
        }
      },
      {
        "match": {
          "method": "item/completed",
          "params.item.type": "commandExecution"
        },
        "emit": {
          "kind": "tool_result",
          "producer": "agent",
          "payload": {
            "content": "$.params.item.aggregatedOutput",
            "duration_ms": "$.params.item.durationMs",
            "exit_code": "$.params.item.exitCode",
            "status": "$.params.item.status",
            "tool_use_id": "$.params.item.id"
          }
        }
      },
      {
        "match": {
          "method": "item/completed",
          "params.item.type": "fileChange"
        },
        "emit": {
          "kind": "tool_result",
          "producer": "agent",
          "payload": {
            "changes": "$.params.item.changes",
            "status": "$.params.item.status",
            "tool_use_id": "$.params.item.id"
          }
        }
      },
      {
        "match": {
          "method": "item/completed",
          "params.item.type": "mcpToolCall"
        },
        "emit": {
          "kind": "tool_result",
          "producer": "agent",
          "payload": {
            "content": "$.params.item.result",
            "is_error": "$.params.item.error",
            "status": "$.params.item.status",
            "tool_use_id": "$.params.item.id"
          }
        }
      },
      {
        "match": {
          "method": "thread/tokenUsage/updated"
        },
        "emit": {
          "kind": "usage",
          "producer": "agent",
          "payload": {
            "cached_input_tokens": "$.params.tokenUsage.total.cachedInputTokens",
            "context_window": "$.params.tokenUsage.modelContextWindow",
            "cumulative": "\"true\"",
            "engine": "\"codex\"",
            "input_tokens": "$.params.tokenUsage.total.inputTokens",
            "last_cached_input_tokens": "$.params.tokenUsage.last.cachedInputTokens",
            "last_input_tokens": "$.params.tokenUsage.last.inputTokens",
            "last_output_tokens": "$.params.tokenUsage.last.outputTokens",
            "last_reasoning_tokens": "$.params.tokenUsage.last.reasoningOutputTokens",
            "last_total_tokens": "$.params.tokenUsage.last.totalTokens",
            "output_tokens": "$.params.tokenUsage.total.outputTokens",
            "reasoning_tokens": "$.params.tokenUsage.total.reasoningOutputTokens",
            "thread_id": "$.params.threadId",
            "total_tokens": "$.params.tokenUsage.total.totalTokens"
          }
        }
      },
      {
        "match": {
          "method": "mcpServer/startupStatus/updated"
        },
        "emit": {
          "kind": "system",
          "producer": "agent",
          "payload": {
            "error": "$.params.error",
            "kind": "\"mcp_server_startup\"",
            "name": "$.params.name",
            "status": "$.params.status"
          }
        }
      }
    ]
  },
